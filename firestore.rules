rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public write access to the playbook_leads collection
    // This allows anyone to submit the form to create a new lead.
    // Reads and updates are disallowed for security.
    match /playbook_leads/{leadId} {
      allow read, update, delete: if false;
      allow create: if true;
    }

    // Deny all other access to prevent unauthorized reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
