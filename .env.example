# Raystrat Systems — environment variables
# Copy to `frontend/.env` (or `.env.local`) and fill in real values locally.
# Never commit a populated file: `.gitignore` matches `.env*`.

# preview | production
# `production` is the ONLY switch that enables search indexing:
# it removes the noindex meta tag + X-Robots-Tag header and makes
# /robots.txt allow crawling and publish the sitemap reference.
SITE_ENV=preview

# Master kill switch for enquiry email delivery.
# While this is anything other than the exact string `true`, POST /enquiry/submit
# returns 503 `not_configured` and the homepage shows the "delivery not switched on"
# note — even if a valid API key is present.
ENQUIRY_DELIVERY_ENABLED=false

# Resend API key, sending access only. Server-side only, never exposed to the client.
# Obtain from https://resend.com -> API Keys.
RESEND_API_KEY=re_your_sending_only_key_here

# Verified sender ("From"). Must be on a domain verified in Resend.
ENQUIRY_FROM_EMAIL=enquiries@send.example.com

# Private enquiry recipient, fixed server-side. Must never be rendered client-side.
ENQUIRY_TO_EMAIL=recipient@example.com
